{
  "name": "trackm-main",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev:server": "cross-env NODE_ENV=development tsx watch server/index.ts",
    "dev:client": "cd client && npm run dev",
    "dev:agent": "cd desktop-agents/python-agent && python windows_agent.py",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"npm run dev:agent\"",
    "install:all": "npm install && cd client && npm install && cd ../desktop-agents/python-agent && pip install -r requirements.txt",
    "build": "npm run build:server && npm run build:client",
    "build:server": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "build:client": "cd client && npm run build",
    "start": "cross-env NODE_ENV=production node dist/index.js"
  },
  "dependencies": {
    "concurrently": "^9.1.2",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.41.0",
    "drizzle-zod": "^0.7.1",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "uuid": "^11.1.0",
    "ws": "^8.18.1",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@replit/vite-plugin-cartographer": "^0.1.2",
    "@replit/vite-plugin-runtime-error-modal": "^0.0.3",
    "@replit/vite-plugin-shadcn-theme-json": "^0.0.4",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.17",
    "@types/express": "4.17.21",
    "@types/express-session": "^1.18.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "20.16.11",
    "@types/pg": "^8.11.2",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.4.1",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.0",
    "terser": "^5.39.0",
    "tsx": "^4.7.1",
    "typescript": "5.6.3",
    "vite": "^6.3.4"
  }
}
