<?xml version="1.0" encoding="utf-8"?><wixObject version="3.0.2002.0" xmlns="http://schemas.microsoft.com/wix/2006/objects"><section id="*" type="product"><table name="_SummaryInformation"><row sourceLineNumber="C:\Users\ahuza\Downloads\trackm-flaskagent-version2\build_agents\test\ActivTrackAgent_Tokenized.wxs*10"><field>1</field><field>1252</field></row><row sourceLineNumber="C:\Users\ahuza\Downloads\trackm-flaskagent-version2\build_agents\test\ActivTrackAgent_Tokenized.wxs*10"><field>2</field><field>Installation Database</field></row><row sourceLineNumber="C:\Users\ahuza\Downloads\trackm-flaskagent-version2\build_agents\test\ActivTrackAgent_Tokenized.wxs*10"><field>3</field><field>ActivTrack Agent - Activity Monitoring Software</field></row><row sourceLineNumber="C:\Users\ahuza\Downloads\trackm-flaskagent-version2\build_agents\test\ActivTrackAgent_Tokenized.wxs*10"><field>4</field><field>ActivTrack Solutions</field></row><row sourceLineNumber="C:\Users\ahuza\Downloads\trackm-flaskagent-version2\build_agents\test\ActivTrackAgent_Tokenized.wxs*10"><field>5</field><field>activity,monitoring,time,tracking,productivity</field></row><row sourceLineNumber="C:\Users\ahuza\Downloads\trackm-flaskagent-version2\build_agents\test\ActivTrackAgent_Tokenized.wxs*10"><field>6</field><field>Installs ActivTrack Agent for activity monitoring and time tracking</field></row><row sourceLineNumber="C:\Users\ahuza\Downloads\trackm-flaskagent-version2\build_agents\test\ActivTrackAgent_Tokenized.wxs*10"><field>7</field><field>Intel;1033</field></row><row sourceLineNumber="C:\Users\ahuza\Downloads\trackm-flaskagent-version2\build_agents\test\ActivTrackAgent_Tokenized.wxs*10"><field>9</field><field>*</field></row><row sourceLineNumber="C:\Users\ahuza\Downloads\trackm-flaskagent-version2\build_agents\test\ActivTrackAgent_Tokenized.wxs*10"><field>14</field><field>500</field></row><row sourceLineNumber="C:\Users\ahuza\Downloads\trackm-flaskagent-version2\build_agents\test\ActivTrackAgent_Tokenized.wxs*10"><field>15</field><field>2</field></row><row sourceLineNumber="C:\Users\ahuza\Downloads\trackm-flaskagent-version2\build_agents\test\ActivTrackAgent_Tokenized.wxs*10"><field>19</field><field>2</field></row></table><table name="CustomAction"><row sourceLineNumber="C:\Users\ahuza\Downloads\trackm-flaskagent-version2\build_agents\test\ActivTrackAgent_Tokenized.wxs*33"><field>StoreTokenInRegistry</field><field>38</field><field /><field>Dim token, objShell, regKey
        
        ' Get the token from property
        token = Session.Property("AGENT_TOKEN")
        
        If token &lt;&gt; "" Then
          ' Store token in registry for the service to read
          Set objShell = CreateObject("WScript.Shell")
          On Error Resume Next
          objShell.RegWrite "HKLM\SOFTWARE\ActivTrack\Token", token, "REG_SZ"
          On Error GoTo 0
        End If</field><field /></row><row sourceLineNumber="C:\Users\ahuza\Downloads\trackm-flaskagent-version2\build_agents\test\ActivTrackAgent_Tokenized.wxs*53"><field>InstallService</field><field>3090</field><field>ActivTrackAgentExe</field><field>install [AGENT_TOKEN]</field><field /></row><row sourceLineNumber="C:\Users\ahuza\Downloads\trackm-flaskagent-version2\build_agents\test\ActivTrackAgent_Tokenized.wxs*61"><field>StartService</field><field>3110</field><field /><field>Dim objShell
        Set objShell = CreateObject("WScript.Shell")
        
        ' Start the service
        On Error Resume Next
        objShell.Run "net start ActivTrackAgent", 0, True
        On Error GoTo 0</field><field /></row><row sourceLineNumber="C:\Users\ahuza\Downloads\trackm-flaskagent-version2\build_agents\test\ActivTrackAgent_Tokenized.wxs*77"><field>StopService</field><field>3110</field><field /><field>Dim objShell
        Set objShell = CreateObject("WScript.Shell")
        
        ' Stop the service
        On Error Resume Next
        objShell.Run "net stop ActivTrackAgent", 0, True
        On Error GoTo 0</field><field /></row><row sourceLineNumber="C:\Users\ahuza\Downloads\trackm-flaskagent-version2\build_agents\test\ActivTrackAgent_Tokenized.wxs*93"><field>UninstallService</field><field>3110</field><field /><field>Dim objShell
        Set objShell = CreateObject("WScript.Shell")
        
        ' Uninstall the service
        On Error Resume Next
        objShell.Run "sc delete ActivTrackAgent", 0, True
        On Error GoTo 0</field><field /></row><row sourceLineNumber="C:\Users\ahuza\Downloads\trackm-flaskagent-version2\build_agents\test\ActivTrackAgent_Tokenized.wxs*109"><field>RemoveRegistryEntries</field><field>3110</field><field /><field>Dim objShell
        
        ' Remove registry entries
        Set objShell = CreateObject("WScript.Shell")
        On Error Resume Next
        objShell.RegDelete "HKLM\SOFTWARE\ActivTrack\Token"
        objShell.RegDelete "HKLM\SOFTWARE\ActivTrack"
        On Error GoTo 0</field><field /></row><row sourceLineNumber="C:\Users\ahuza\Downloads\trackm-flaskagent-version2\build_agents\test\ActivTrackAgent_Tokenized.wxs*126"><field>CreateAppDataDir</field><field>38</field><field /><field>Dim appDataPath, fso
        
        ' Get AppData path
        appDataPath = CreateObject("WScript.Shell").ExpandEnvironmentStrings("%APPDATA%")
        appDataPath = appDataPath &amp; "\ActivTrack"
        
        ' Create ActivTrack directory if it doesn't exist
        Set fso = CreateObject("Scripting.FileSystemObject")
        If Not fso.FolderExists(appDataPath) Then
          fso.CreateFolder appDataPath
        End If
        
        ' Create logs subdirectory
        If Not fso.FolderExists(appDataPath &amp; "\logs") Then
          fso.CreateFolder appDataPath &amp; "\logs"
        End If</field><field /></row></table><table name="Feature"><row sourceLineNumber="C:\Users\ahuza\Downloads\trackm-flaskagent-version2\build_agents\test\ActivTrackAgent_Tokenized.wxs*164"><field>ProductFeature</field><field /><field>ActivTrack Agent</field><field /><field>2</field><field>1</field><field /><field>0</field></row></table><table name="LaunchCondition"><row sourceLineNumber="C:\Users\ahuza\Downloads\trackm-flaskagent-version2\build_agents\test\ActivTrackAgent_Tokenized.wxs*20"><field>NOT WIX_DOWNGRADE_DETECTED</field><field>A newer version of [ProductName] is already installed.</field></row></table><table name="Media"><row sourceLineNumber="C:\Users\ahuza\Downloads\trackm-flaskagent-version2\build_agents\test\ActivTrackAgent_Tokenized.wxs*24"><field>1</field><field>0</field><field /><field>#product.cab</field><field /><field /></row></table><table name="Property"><row sourceLineNumber="C:\Users\ahuza\Downloads\trackm-flaskagent-version2\build_agents\test\ActivTrackAgent_Tokenized.wxs*10"><field>ALLUSERS</field><field>1</field></row><row sourceLineNumber="C:\Users\ahuza\Downloads\trackm-flaskagent-version2\build_agents\test\ActivTrackAgent_Tokenized.wxs*27"><field>AGENT_TOKEN</field><field /></row><row sourceLineNumber="C:\Users\ahuza\Downloads\trackm-flaskagent-version2\build_agents\test\ActivTrackAgent_Tokenized.wxs*30"><field>WIXUI_INSTALLDIR</field><field>INSTALLFOLDER</field></row></table><table name="Upgrade"><row sourceLineNumber="C:\Users\ahuza\Downloads\trackm-flaskagent-version2\build_agents\test\ActivTrackAgent_Tokenized.wxs*20"><field>{3F2504E0-4F89-11D3-9A0C-0305E82C3301}</field><field /><field>1.0.0.0</field><field /><field>1</field><field /><field>WIX_UPGRADE_DETECTED</field></row><row sourceLineNumber="C:\Users\ahuza\Downloads\trackm-flaskagent-version2\build_agents\test\ActivTrackAgent_Tokenized.wxs*20"><field>{3F2504E0-4F89-11D3-9A0C-0305E82C3301}</field><field>1.0.0.0</field><field /><field /><field>2</field><field /><field>WIX_D